#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform texture2D source_image;
#ifdef DEPTH_OUTPUT
layout(set=0,binding=1,r32f) uniform writeonly image2D destination;
#else
layout(set=0,binding=1,rgba8) uniform writeonly image2D destination;
#endif
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p,imageSize(destination)))) return;
    imageStore(destination,p,texelFetch(source_image,p,0));
}
