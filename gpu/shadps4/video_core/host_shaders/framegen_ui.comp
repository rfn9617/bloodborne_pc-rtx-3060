#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform texture2D finished_display;
layout(set=0,binding=1) uniform texture2D clean_scene;
layout(set=0,binding=2) uniform texture2D generated_scene;
layout(set=0,binding=3,rgba8) uniform writeonly image2D destination;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p,imageSize(destination)))) return;
    vec4 actual=texelFetch(finished_display,p,0);
    vec4 clean=texelFetch(clean_scene,p,0);
    // Both references are in the final game display encoding. Typed UNORM
    // views preserve canonical RGB from either RGBA or BGRA without a copy.
    bool changed=any(greaterThan(abs(actual.rgb-clean.rgb),vec3(0.5/255.0)));
    vec4 result=changed ? actual : texelFetch(generated_scene,p,0);
    imageStore(destination,p,vec4(result.rgb,1.0));
}
