+#!/usr/bin/env python3
+"""Generate the opt-in, exact SAD search optimization without modifying the SDK."""
+
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import os
+import re
+import struct
+import subprocess
+import sys
+
+DXC_SHA256 = "aa7965b3763d9c710baaa5a28cedcc633449962a75d1391d161a85304a41b3e2"
+
+
+def optimize(source):
+    declaration = "FFX_GROUPSHARED FfxUInt32 sadMapBuffer[4][SearchRadiusY * 2][(SearchRadiusX * 2) / 4 + bankBreaker];"
+    assert source.count(declaration) == 1
+    code = source.replace(declaration, "// Each lane reduces its own four candidates in registers; no shared SAD map.")
+    start = code.index("FfxUInt32 SadMapMinReduction256(")
+    end = code.index("\nvoid LoadSearchBuffer", start)
+    reduction = code[start:end]
+    a = reduction.index("    FfxUInt32 min01")
+    b = reduction.index("    min0123 = ffxWaveMin", a)
+    reduction = reduction[:a] + '''    FfxUInt32 min01 = ffxMin((qsad.x << 16) | EncodeSearchCoord(FfxInt32x2(iSearchId.x * 4 + 0, iSearchId.y)),
+                              (qsad.y << 16) | EncodeSearchCoord(FfxInt32x2(iSearchId.x * 4 + 1, iSearchId.y)));
+    FfxUInt32 min23 = ffxMin((qsad.z << 16) | EncodeSearchCoord(FfxInt32x2(iSearchId.x * 4 + 2, iSearchId.y)),
+                              (qsad.w << 16) | EncodeSearchCoord(FfxInt32x2(iSearchId.x * 4 + 3, iSearchId.y)));
+    FfxUInt32 min0123 = ffxMin(min01, min23);
+''' + reduction[b:]
+    reduction = reduction.replace("FfxInt32 iLocalIndex)", "FfxInt32 iLocalIndex, FfxUInt32x4 qsad)", 1)
+    code = code[:start] + code[end:]
+    start = code.index("void PrepareSadMap(")
+    end = code.index("\n\nuint ABfe", start)
+    code = code[:start] + reduction + code[end:]
+    old = "            PrepareSadMap(iSearchId, qsad);\n            FfxUInt32 minSad = SadMapMinReduction256(iSearchId, iLocalIndex);"
+    assert code.count(old) == 1
+    code = code.replace(old, "            FfxUInt32 minSad = SadMapMinReduction256(iSearchId, iLocalIndex, qsad);")
+    old = "            {\n                StoreOpticalFlow(ofGroupOffset + blockId, newVector);\n            }"
+    assert code.count(old) == 1
+    code = code.replace(old, '''            // Group reductions broadcast the same vector to all 64 lanes.
+            // One writer per block preserves the result and avoids duplicate stores.
+            if (iLocalIndex == 0)
+            {
+                StoreOpticalFlow(ofGroupOffset + blockId, newVector);
+            }''')
+    old = "    for (FfxInt32 dy = 0; dy < CompareSize; dy++)"
+    assert code.count(old) == 1
+    code = code.replace(old, "    [unroll]\n" + old)
+    assert "sadMapBuffer" not in code and "PrepareSadMap" not in code
+    return code
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dxc", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True, help="New empty build directory")
+    parser.add_argument("--spirv-val", default="spirv-val")
+    parser.add_argument("--spirv-dis", default="spirv-dis")
+    args = parser.parse_args()
+    dxc = args.dxc.resolve()
+    assert hashlib.sha256(dxc.read_bytes()).hexdigest() == DXC_SHA256, "Unreviewed DXC toolchain"
+    out = args.output.resolve()
+    assert not out.exists() or not any(out.iterdir()), "Output directory must be empty"
+    out.mkdir(parents=True, exist_ok=True)
+    module = Path(__file__).resolve().parent.parent
+    sdk = module / "upstream/ffx-2.3.0/Kits/FidelityFX"
+    include = sdk / "framegeneration/fsr3/include/gpu"
+    core = sdk / "api/internal/gpu"
+    subprocess.run([sys.executable, str(module / "tools/prepare_fsr3_3_1_6_vulkan_sources.py"),
+                    str(include), str(out / "overlay")], check=True)
+    source_path = include / "opticalflow/ffx_opticalflow_compute_optical_flow_v5.h"
+    source = source_path.read_text(encoding="utf-8")
+    optimized = optimize(source)
+    shader = sdk / "framegeneration/fsr3/internal/shaders/ffx_opticalflow_compute_optical_flow_advanced_pass_v5.hlsl"
+    command = [str(dxc), "-spirv", "-fspv-target-env=vulkan1.2", "-T", "cs_6_2", "-E", "CS",
+        "-DFFX_GPU=1", "-DFFX_HLSL=1", "-DFFX_OPTICALFLOW_EMBED_ROOTSIG=0", "-DFFX_OPTICALFLOW_OPTION_HDR_COLOR_INPUT=0",
+        "-I", str(core), "-I", str(out / "overlay"), "-I", str(include),
+        "-fvk-t-shift", "0", "all", "-fvk-u-shift", "2", "all", "-fvk-b-shift", "4", "all",
+        "-fvk-s-shift", "1000", "all", str(shader)]
+    lines = ["/* Auto-generated exact optical-flow search variants; see build-manifest.json. */",
+             "#pragma once", "#include <stdint.h>"]
+    modules = []
+    for name, code in [("REFERENCE", source), ("OPTIMIZED", optimized)]:
+        (out / "overlay/opticalflow" / source_path.name).write_text(code, encoding="utf-8")
+        spv = out / f"search-{name.lower()}.spv"
+        result = subprocess.run(command + ["-Fo", str(spv)], capture_output=True)
+        (out / f"compile-{name.lower()}.log").write_bytes(result.stdout + result.stderr)
+        result.check_returncode()
+        subprocess.run([args.spirv_val, "--target-env", "vulkan1.2", str(spv)], check=True)
+        assembly = spv.with_suffix(".spvasm")
+        subprocess.run([args.spirv_dis, str(spv), "-o", str(assembly)], check=True)
+        bindings = re.findall(r"OpDecorate %(.+) Binding (\d+)", assembly.read_text())
+        assert len(bindings) == 5 and sorted(int(b) for _, b in bindings) == list(range(5)), bindings
+        data = spv.read_bytes()
+        words = struct.unpack(f"<{len(data)//4}I", data)
+        lines.append(f"static const uint32_t FFX_VK_OPTICALFLOW_SEARCH_{name}[] = {{")
+        for i in range(0, len(words), 8):
+            lines.append("    " + ", ".join(f"0x{w:08x}u" for w in words[i:i+8]) + ",")
+        lines.append("};")
+        modules.append(dict(name=name, sha256=hashlib.sha256(data).hexdigest(), bindings=bindings))
+    (out / "ffx_vk_fsr3_3_1_6_opticalflow_search.h").write_text("\n".join(lines) + "\n", encoding="utf-8")
+    inputs = {str(p.relative_to(sdk)): hashlib.sha256(p.read_bytes()).hexdigest()
+              for root in [include, core] for p in sorted(root.rglob("*.h"))}
+    inputs[str(shader.relative_to(sdk))] = hashlib.sha256(shader.read_bytes()).hexdigest()
+    manifest = dict(compiler_sha256=DXC_SHA256, compile_args=command, modules=modules,
+                    source_sha256=hashlib.sha256(source_path.read_bytes()).hexdigest(),
+                    optimized_source_sha256=hashlib.sha256(optimized.encode()).hexdigest(), inputs=inputs)
+    (out / "build-manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+    print(json.dumps(modules))
+
+
+if __name__ == "__main__":
+    main()
